# Copy to .env and fill in your own local values. Never commit .env.
# Keep all PS-02 workbooks (*.xlsx) and converted files local and gitignored.

# Server & App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite proxy / API base)
VITE_API_BASE_URL=/api

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/innovedam_ps02?schema=public

# Authentication (bcrypt + JWT in HttpOnly cookie)
JWT_SECRET=replace-with-local-random-32-char-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=ripple_session
COOKIE_SECURE=false

# Local seeded demo users (for dev/judging verification of Internal vs Confidential views)
SEED_DEMO_PASSWORD=replace-with-local-demo-password

# AI / External APIs: Not used in MVP (deterministic R1-R5 engine).
